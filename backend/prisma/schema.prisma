generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  accounts      Account[]
  cards         Card[]
  categories    Category[]
  transactions  Transaction[]
  invoices      Invoice[]
  payableGroups PayableGroup[]
  payables      Payable[]
  importBatches ImportBatch[]

  @@map("users")
}

/// Catálogo de bancos compartilhado entre usuários (sem user_id) — RF-06.
model Bank {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  accounts Account[]

  @@map("banks")
}

model Account {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  name           String
  bankId         String   @map("bank_id")
  currency       String   @default("BRL") @db.Char(3)
  initialBalance Decimal  @default(0) @map("initial_balance") @db.Decimal(12, 2)
  isActive       Boolean  @default(true) @map("is_active")
  isHidden       Boolean  @default(false) @map("is_hidden")
  createdAt      DateTime @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id])
  bank          Bank           @relation(fields: [bankId], references: [id])
  linkedCards   Card[]         @relation("CardLinkedAccount")
  transactions  Transaction[]
  paidInvoices  Invoice[]
  payableGroups PayableGroup[]
  payables      Payable[]
  importBatches ImportBatch[]

  @@unique([userId, name])
  @@map("accounts")
}

model Card {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String
  creditLimit     Decimal  @map("credit_limit") @db.Decimal(12, 2)
  closingDay      Int      @map("closing_day")
  dueDay          Int      @map("due_day")
  linkedAccountId String?  @map("linked_account_id")
  isActive        Boolean  @default(true) @map("is_active")
  isHidden        Boolean  @default(false) @map("is_hidden")
  createdAt       DateTime @default(now()) @map("created_at")

  user          User          @relation(fields: [userId], references: [id])
  linkedAccount Account?      @relation("CardLinkedAccount", fields: [linkedAccountId], references: [id], onDelete: SetNull)
  transactions  Transaction[]
  invoices      Invoice[]
  importBatches ImportBatch[]

  @@unique([userId, name])
  @@map("cards")
}

/// Fatura de cartão (Etapa 4) — agrupa Transactions de um Card num período mensal real.
/// Sem coluna de status: aberta/fechada/atrasada/paga é sempre derivado na leitura a partir de
/// closingDate/dueDate/paidAt (ver invoiceStatus.ts).
model Invoice {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  cardId               String    @map("card_id")
  periodYear           Int       @map("period_year")
  periodMonth          Int       @map("period_month")
  closingDate          DateTime  @map("closing_date") @db.Date
  dueDate              DateTime  @map("due_date") @db.Date
  paidAt               DateTime? @map("paid_at")
  paymentAccountId     String?   @map("payment_account_id")
  paymentTransactionId String?   @unique @map("payment_transaction_id")
  createdAt            DateTime  @default(now()) @map("created_at")

  user               User          @relation(fields: [userId], references: [id])
  card               Card          @relation(fields: [cardId], references: [id])
  paymentAccount     Account?      @relation(fields: [paymentAccountId], references: [id])
  paymentTransaction Transaction?  @relation("InvoicePayment", fields: [paymentTransactionId], references: [id])
  transactions       Transaction[] @relation("InvoiceTransactions")

  @@unique([cardId, periodYear, periodMonth])
  @@map("invoices")
}

enum TransactionType {
  income
  expense
}

/// Catálogo de categorias — mesmo padrão do Bank: user_id nulo = categoria do seed,
/// compartilhada e somente leitura; preenchido = categoria própria do usuário.
model Category {
  id        String          @id @default(uuid())
  userId    String?         @map("user_id")
  name      String
  type      TransactionType
  createdAt DateTime        @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id])
  transactions Transaction[]
  importedRows ImportedRow[]

  @@map("categories")
}

model Transaction {
  id                    String          @id @default(uuid())
  userId                String          @map("user_id")
  type                  TransactionType
  amount                Decimal         @db.Decimal(12, 2)
  description           String
  date                  DateTime        @db.Date
  categoryId            String?         @map("category_id")
  accountId             String?         @map("account_id")
  cardId                String?         @map("card_id")
  invoiceId             String?         @map("invoice_id")
  refundOfTransactionId String?         @map("refund_of_transaction_id")
  installmentGroupId    String?         @map("installment_group_id")
  installmentNumber     Int?            @map("installment_number")
  installmentCount      Int?            @map("installment_count")
  externalId            String?         @map("external_id")
  importBatchId         String?         @map("import_batch_id")
  createdAt             DateTime        @default(now()) @map("created_at")

  user                  User          @relation(fields: [userId], references: [id])
  category              Category?     @relation(fields: [categoryId], references: [id])
  account               Account?      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  card                  Card?         @relation(fields: [cardId], references: [id], onDelete: Restrict)
  invoice               Invoice?      @relation("InvoiceTransactions", fields: [invoiceId], references: [id])
  invoicePayment        Invoice?      @relation("InvoicePayment")
  refundOf              Transaction?  @relation("RefundOf", fields: [refundOfTransactionId], references: [id])
  refunds               Transaction[] @relation("RefundOf")
  paidPayable           Payable?      @relation("PayablePayment")
  importBatch           ImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  importedRowDuplicates ImportedRow[] @relation("ImportedRowDuplicate")
  importedRowCreated    ImportedRow?  @relation("ImportedRowCreated")

  @@map("transactions")
}

enum PayableRecurrenceType {
  installment
  recurring
}

/// Conta a pagar/receber "grupo" (Etapa 5) — dados comuns de uma obrigação parcelada ou
/// recorrente. Não existe para uma conta avulsa (RF-01): nesse caso a própria Payable carrega
/// description/counterparty/accountId direto, com groupId nulo.
model PayableGroup {
  id               String                @id @default(uuid())
  userId           String                @map("user_id")
  type             TransactionType
  recurrenceType   PayableRecurrenceType @map("recurrence_type")
  installmentCount Int?                  @map("installment_count")
  amount           Decimal               @db.Decimal(12, 2)
  dueDay           Int                   @map("due_day")
  description      String?
  counterparty     String?
  accountId        String?               @map("account_id")
  createdAt        DateTime              @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id])
  account  Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  payables Payable[]

  @@map("payable_groups")
}

/// Parcela de conta a pagar/receber (Etapa 5) — obrigação futura, ainda não um fato financeiro
/// consumado. Vira uma Transaction real só quando paga (paidTransactionId, RF-05). Sem coluna de
/// status persistida: pendente/vence_hoje/atrasada/paga/cancelada é sempre derivado na leitura
/// (mesmo padrão de Invoice na Etapa 4 — ver payableStatus.ts).
model Payable {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  groupId            String?   @map("group_id")
  type               TransactionType
  amount             Decimal   @db.Decimal(12, 2)
  dueDate            DateTime  @map("due_date") @db.Date
  installmentNumber  Int?      @map("installment_number")
  description        String?
  counterparty       String?
  accountId          String?   @map("account_id")
  paidAmount         Decimal?  @map("paid_amount") @db.Decimal(12, 2)
  paidTransactionId  String?   @unique @map("paid_transaction_id")
  paidAt             DateTime? @map("paid_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason")
  createdAt          DateTime  @default(now()) @map("created_at")

  user            User          @relation(fields: [userId], references: [id])
  group           PayableGroup? @relation(fields: [groupId], references: [id])
  account         Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  paidTransaction Transaction?  @relation("PayablePayment", fields: [paidTransactionId], references: [id])

  @@map("payables")
}

enum ImportFormat {
  ofx
  csv
  pdf_invoice
}

enum ImportMode {
  staged
  direct
}

enum ImportBatchStatus {
  processando
  aguardando_revisao
  concluido
  falhou
}

enum ImportedRowResolution {
  pendente
  aceita
  descartada
}

/// Lote de importação de arquivo (Etapa 6). O arquivo original (rawContent) só existe durante a
/// janela de processamento — sempre gravado como NULL ao final, sucesso ou falha (RF-02).
model ImportBatch {
  id           String            @id @default(uuid())
  userId       String            @map("user_id")
  format       ImportFormat
  accountId    String?           @map("account_id")
  cardId       String?           @map("card_id")
  mode         ImportMode
  status       ImportBatchStatus @default(processando)
  fileHash     String            @map("file_hash") @db.Char(64)
  rawContent   Bytes?            @map("raw_content")
  errorMessage String?           @map("error_message")
  createdAt    DateTime          @default(now()) @map("created_at")
  processedAt  DateTime?         @map("processed_at")

  user         User          @relation(fields: [userId], references: [id])
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  card         Card?         @relation(fields: [cardId], references: [id], onDelete: Restrict)
  rows         ImportedRow[]
  transactions Transaction[]

  @@map("import_batches")
}

/// Linha extraída de um lote (Etapa 6) — gerada para toda linha extraída, mesmo aceita
/// automaticamente no modo `direct` (histórico auditável do lote). Sem coluna de status
/// derivado como Invoice/Payable: aqui as transições só acontecem por ação do processamento ou
/// do usuário, então `resolution` já é suficiente como coluna direta.
model ImportedRow {
  id                       String                 @id @default(uuid())
  importBatchId            String                 @map("import_batch_id")
  date                     DateTime               @db.Date
  description              String
  amount                   Decimal                @db.Decimal(12, 2)
  type                     TransactionType
  externalId               String?                @map("external_id")
  isDuplicateSuspect       Boolean                @default(false) @map("is_duplicate_suspect")
  duplicateOfTransactionId String?                @map("duplicate_of_transaction_id")
  suggestedCategoryId      String?                @map("suggested_category_id")
  resolution               ImportedRowResolution  @default(pendente)
  createdTransactionId     String?                @unique @map("created_transaction_id")
  createdAt                DateTime               @default(now()) @map("created_at")

  importBatch            ImportBatch  @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  duplicateOfTransaction Transaction? @relation("ImportedRowDuplicate", fields: [duplicateOfTransactionId], references: [id], onDelete: SetNull)
  suggestedCategory      Category?    @relation(fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  createdTransaction     Transaction? @relation("ImportedRowCreated", fields: [createdTransactionId], references: [id], onDelete: SetNull)

  @@map("imported_rows")
}
